:root {
  --bg: #ffffff;
  --alt-bg: #f4f4f6;
  --text: #111827;
  --muted: #4b5563;
  --primary: #ea580c;
  --primary-dark: #c2410c;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: 'Segoe UI', system-ui, sans-serif;
  color: var(--text);
  background: var(--bg);
  line-height: 1.6;
}

/* Navbar */
header {
  background: #111827;
  color: #fff;
  padding: 1rem 2rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: sticky;
  top: 0;
  z-index: 50;
}

.brand {
  font-size: 1.3rem;
  font-weight: 800;
  letter-spacing: 1px;
}

.brand span {
  color: var(--primary);
}

nav a {
  color: #d1d5db;
  text-decoration: none;
  margin-left: 1.5rem;
  font-size: 0.95rem;
}

nav a:hover {
  color: #fff;
}

/* Hero */
.hero {
  background: linear-gradient(135deg, #111827 0%, #1f2937 100%);
  color: #fff;
  padding: 5rem 2rem;
}

.hero-inner {
  max-width: 1150px;
  margin: auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: center;
}

.hero-tag {
  background: rgba(234, 88, 12, 0.2);
  color: #fb923c;
  padding: 0.3rem 0.8rem;
  border-radius: 99px;
  font-size: 0.85rem;
  font-weight: 600;
}

.hero h1 {
  font-size: clamp(2.4rem, 5vw, 3.8rem);
  margin: 1rem 0;
  line-height: 1.1;
}

.hero p {
  color: #9ca3af;
  font-size: 1.1rem;
  margin-bottom: 2rem;
}

.hero-media {
  text-align: center;
}

.hero img {
  width: 100%;
  max-width: 450px;
  border-radius: 20px;
  box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5);
}

.btn {
  display: inline-block;
  background: var(--primary);
  color: #fff;
  padding: 0.85rem 1.8rem;
  border-radius: 8px;
  text-decoration: none;
  font-weight: 700;
  border: none;
  cursor: pointer;
  transition: 0.2s;
}

.btn:hover {
  background: var(--primary-dark);
}

/* Container */
.container {
  max-width: 1150px;
  margin: auto;
  padding: 4.5rem 2rem;
}

.section-title {
  text-align: center;
  font-size: 2.1rem;
  margin-bottom: 0.5rem;
}

.section-sub {
  text-align: center;
  color: var(--muted);
  margin-bottom: 3rem;
}

/* Features */
.features-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 1.5rem;
}

.feature-box {
  background: var(--alt-bg);
  padding: 2rem;
  border-radius: 14px;
  border-bottom: 4px solid var(--primary);
}

.feature-box h3 {
  margin-bottom: 0.5rem;
  font-size: 1.2rem;
}

/* Specs Table */
.specs-wrapper {
  background: var(--alt-bg);
  padding: 4rem 2rem;
}

table {
  width: 100%;
  max-width: 850px;
  margin: auto;
  border-collapse: collapse;
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
}

th,
td {
  padding: 1rem 1.5rem;
  text-align: left;
  border-bottom: 1px solid #e5e7eb;
}

th {
  background: #111827;
  color: #fff;
  width: 35%;
}

/* Reviews */
.reviews-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.5rem;
}

.review-card {
  border: 1px solid #e5e7eb;
  padding: 1.5rem;
  border-radius: 12px;
}

.stars {
  color: #f59e0b;
  margin-bottom: 0.5rem;
}

.reviewer {
  display: block;
  margin-top: 0.75rem;
}

/* Purchase Section */
.buy-box {
  background: #111827;
  color: #fff;
  border-radius: 20px;
  padding: 3rem;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 2rem;
}

.buy-note {
  color: #9ca3af;
  margin-top: 0.5rem;
}

.buy-action {
  text-align: right;
}

.buy-btn {
  margin-top: 0.5rem;
}

.price {
  font-size: 2.5rem;
  font-weight: 800;
  color: #fb923c;
}

footer {
  text-align: center;
  padding: 2rem;
  color: var(--muted);
  font-size: 0.9rem;
}

@media (max-width: 768px) {
  .hero-inner {
    grid-template-columns: 1fr;
    text-align: center;
  }

  nav {
    display: none;
  }
}
